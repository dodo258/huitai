{
  "_说明": "额度取数规则。每家按顺序试渠道，前一个取不到或格式不认识就换下一个。厂商改格式时只改这里。路径用 JSON Pointer（RFC 6901）。",
  "claude": [
    {
      "kind": "statusline",
      "cache_file": "claude-statusline.json",
      "max_age_minutes": 10,
      "windows": [
        { "percent": "/rate_limits/five_hour/used_percentage", "resets_at": "/rate_limits/five_hour/resets_at", "minutes": 300 },
        { "percent": "/rate_limits/seven_day/used_percentage", "resets_at": "/rate_limits/seven_day/resets_at", "minutes": 10080 }
      ]
    },
    {
      "kind": "usage_api",
      "url": "https://api.anthropic.com/api/oauth/usage",
      "headers": ["anthropic-beta: oauth-2025-04-20"],
      "keychain_service": "Claude Code-credentials",
      "token": "/claudeAiOauth/accessToken",
      "expires_at_ms": "/claudeAiOauth/expiresAt",
      "timeout_secs": 5,
      "cache_file": "claude-usage.json",
      "cache_minutes": 5,
      "windows": [
        { "percent": "/five_hour/utilization", "resets_at": "/five_hour/resets_at", "minutes": 300 },
        { "percent": "/seven_day/utilization", "resets_at": "/seven_day/resets_at", "minutes": 10080 }
      ]
    },
    {
      "kind": "tokens_today",
      "dir": ".claude/projects",
      "line_contains": "\"usage\"",
      "matches": { "/type": "assistant" },
      "timestamp": "/timestamp",
      "dedupe": ["/message/id", "/requestId"],
      "count": [
        "/message/usage/input_tokens",
        "/message/usage/output_tokens",
        "/message/usage/cache_creation_input_tokens",
        "/message/usage/cache_read_input_tokens"
      ]
    }
  ],
  "codex": [
    {
      "kind": "rollout",
      "dir": ".codex/sessions",
      "line_contains": "\"token_count\"",
      "matches": { "/type": "event_msg", "/payload/type": "token_count" },
      "timestamp": "/timestamp",
      "max_files": 20,
      "tail_bytes": 262144,
      "windows": [
        { "percent": "/payload/rate_limits/primary/used_percent", "resets_at": "/payload/rate_limits/primary/resets_at", "minutes": "/payload/rate_limits/primary/window_minutes" },
        { "percent": "/payload/rate_limits/secondary/used_percent", "resets_at": "/payload/rate_limits/secondary/resets_at", "minutes": "/payload/rate_limits/secondary/window_minutes" }
      ]
    },
    {
      "kind": "tokens_today",
      "dir": ".codex/sessions",
      "line_contains": "\"token_count\"",
      "matches": { "/type": "event_msg", "/payload/type": "token_count" },
      "timestamp": "/timestamp",
      "cumulative": true,
      "count": ["/payload/info/total_token_usage/total_tokens"]
    }
  ],
  "pi": [
    {
      "kind": "tokens_today",
      "dir": ".pi/agent/sessions",
      "line_contains": "\"usage\"",
      "matches": { "/type": "message", "/message/role": "assistant" },
      "timestamp": "/timestamp",
      "count": ["/message/usage/totalTokens"]
    }
  ],
  "balance": {
    "_说明": "API 余额和订阅额度。每把密钥只发给它自己那家（url 的域名必须在代码里那家的域名表里）。public=false 的是没有公开文档的接口，照官方开源工具的写法接，界面上标「非公开接口」。",
    "timeout_secs": 5,
    "cache_minutes": 5,
    "backoff_minutes": 10,
    "backoff_max_minutes": 60,
    "cache_file": "balance.json",
    "providers": {
      "deepseek": {
        "url": "https://api.deepseek.com/user/balance", "public": true,
        "parse": { "kind": "money_list", "list": "/balance_infos", "currency": "/currency", "amount": "/total_balance", "available": "/is_available" }
      },
      "moonshot_cn": {
        "url": "https://api.moonshot.cn/v1/users/me/balance", "public": true,
        "parse": { "kind": "money", "amount": "/data/available_balance", "debt": "/data/cash_balance", "currency": "CNY" }
      },
      "moonshot_intl": {
        "url": "https://api.moonshot.ai/v1/users/me/balance", "public": true,
        "parse": { "kind": "money", "amount": "/data/available_balance", "debt": "/data/cash_balance", "currency": "USD" }
      },
      "openrouter": {
        "url": "https://openrouter.ai/api/v1/key", "public": true,
        "parse": { "kind": "credit", "usage": "/data/usage", "limit": "/data/limit", "remaining": "/data/limit_remaining", "currency": "USD" }
      },
      "kimi_code": {
        "url": "https://api.kimi.com/coding/v1/usages", "public": false,
        "parse": { "kind": "windows", "windows": [
          { "items": "/limits", "detail": "/detail", "used": "/used", "limit": "/limit", "remaining": "/remaining",
            "resets_at": ["/resetTime", "/resetAt", "/reset_at", "/reset_time"],
            "duration": "/window/duration", "unit": "/window/timeUnit", "units": { "MINUTE": 1, "HOUR": 60, "DAY": 1440 } },
          { "items": "/usage", "used": "/used", "limit": "/limit", "remaining": "/remaining",
            "resets_at": ["/resetTime", "/resetAt", "/reset_at", "/reset_time"], "label": "周" }
        ] }
      }
    }
  }
}
